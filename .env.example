# ── Docker Compose 환경 변수 ──

# 필수: JWT 시크릿 (반드시 변경)
JWT_SECRET_KEY=change-me-generate-a-random-secret

# 필수: OpenAI API 키
OPENAI_API_KEY=sk-your-key-here

# 선택: 국가법령정보센터 API 키
LAW_API_KEY=

# 선택: PostgreSQL 비밀번호 (기본값: ehs_secret_2024)
DB_PASSWORD=ehs_secret_2024

# 선택: 외부 포트 (기본값: 80)
PORT=80

# ── 로컬 개발용 (packages/api/.env에 복사) ──
# EHS_DATABASE_URL=sqlite:///./ehs.db
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# OPENAI_TIMEOUT=90
# EHS_DB_DIRS=vector_db_law,vector_db_rule

# ── 프론트엔드 로컬 개발용 (apps/admin/.env, apps/worker/.env에 복사) ──
# VITE_API_URL=http://localhost:8000
